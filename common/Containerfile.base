# Base Image for Linux CTF Labs
FROM debian:bookworm-slim

# Avoid interactive prompts during apt
ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm-256color

# 1. Un-minimize Debian: remove dpkg exclusions so manual pages are preserved
RUN rm -f /etc/dpkg/dpkg.cfg.d/docker /etc/dpkg/dpkg.cfg.d/excludes

# 2. Install documentation utilities, compiler tools, and reinstall base utilities to unpack their man pages
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    man-db \
    manpages \
    manpages-dev \
    less \
    file \
    bsdextrautils \
    gcc \
    libc6-dev \
    procps \
    tree \
    ca-certificates \
    && apt-get install -y --reinstall \
    coreutils \
    findutils \
    grep \
    tar \
    gzip \
    sed \
    diffutils \
    && rm -rf /var/lib/apt/lists/* \
    && mandb -c

# Create non-root learner user
RUN useradd -m -s /bin/bash learner

# Copy common assets
COPY common/validator/submit_flag.c /opt/linux_ctf/submit_flag.c
COPY common/scripts/motd_banner.sh /usr/local/bin/motd_banner
COPY common/scripts/hint.sh /usr/local/bin/hint
RUN chmod 755 /usr/local/bin/motd_banner /usr/local/bin/hint \
    && ln -sf /usr/local/bin/hint /usr/local/bin/show-hint

# Setup global bashrc hook so MOTD prints on shell start
RUN echo 'if [ -f /usr/local/bin/motd_banner ]; then /usr/local/bin/motd_banner; fi' >> /etc/bash.bashrc \
    && echo 'PS1="\[\033[1;32m\]learner@linux-ctf\[\033[0m\]:\[\033[1;34m\]\w\[\033[0m\]\$ "' >> /home/learner/.bashrc \
    && chown learner:learner /home/learner/.bashrc

COPY common/scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

WORKDIR /home/learner
USER root
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
