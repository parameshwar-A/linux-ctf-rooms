# Base Image for Linux CTF Labs
FROM debian:bookworm-slim

# Avoid interactive prompts during apt
ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm-256color

# 1. Un-minimize Debian: remove dpkg exclusions so manual pages are preserved
RUN rm -f /etc/dpkg/dpkg.cfg.d/docker /etc/dpkg/dpkg.cfg.d/excludes

# 2. Install documentation utilities, compiler tools, and reinstall base utilities to unpack their man pages
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    man-db \
    manpages \
    manpages-dev \
    less \
    file \
    bsdextrautils \
    gcc \
    libc6-dev \
    procps \
    tree \
    ca-certificates \
    && apt-get install -y --reinstall \
    coreutils \
    findutils \
    grep \
    tar \
    gzip \
    sed \
    diffutils \
    && rm -rf /var/lib/apt/lists/* \
    && mandb -c

# Create non-root learner user
RUN useradd -m -s /bin/bash learner

# Copy and compile daemon and thin-client verifiers
COPY common/validator/ctf_checkd.c /tmp/ctf_checkd.c
COPY common/validator/submit_flag_client.c /tmp/submit_flag_client.c
COPY common/validator/clients/ /tmp/clients/
COPY common/ctf_rand.h /usr/local/include/ctf_rand.h
RUN gcc -O2 -s /tmp/ctf_checkd.c -o /usr/local/bin/ctf-checkd \
    && gcc -O2 -s /tmp/submit_flag_client.c -o /usr/local/bin/submit-flag \
    && gcc -O2 -s /tmp/clients/verify_dispatch.c -o /usr/local/bin/verify_dispatch \
    && gcc -O2 -s /tmp/clients/check_production.c -o /usr/local/bin/check_production \
    && gcc -O2 -s /tmp/clients/verify_vault.c -o /usr/local/bin/verify_vault \
    && gcc -O2 -s /tmp/clients/sec_beacon.c -o /usr/local/bin/sec-beacon \
    && gcc -O2 -s /tmp/clients/report_attacker.c -o /usr/local/bin/report_attacker \
    && rm -rf /tmp/ctf_checkd.c /tmp/submit_flag_client.c /tmp/clients \
    && chmod 0700 /usr/local/bin/ctf-checkd \
    && chmod 0755 /usr/local/bin/submit-flag /usr/local/bin/sec-beacon \
    && chmod 0711 /usr/local/bin/verify_dispatch /usr/local/bin/check_production /usr/local/bin/verify_vault /usr/local/bin/report_attacker

# Copy helper scripts
COPY common/scripts/motd_banner.sh /usr/local/bin/motd_banner
COPY common/scripts/hint.sh /usr/local/bin/hint
RUN chmod 755 /usr/local/bin/motd_banner /usr/local/bin/hint \
    && ln -sf /usr/local/bin/hint /usr/local/bin/show-hint

# Setup global bashrc hook so MOTD prints on shell start
RUN echo 'if [ -f /usr/local/bin/motd_banner ]; then /usr/local/bin/motd_banner; fi' >> /etc/bash.bashrc \
    && echo 'PS1="\[\033[1;32m\]learner@linux-ctf\[\033[0m\]:\[\033[1;34m\]\w\[\033[0m\]\$ "' >> /home/learner/.bashrc \
    && chown learner:learner /home/learner/.bashrc

# Strip SUID/SGID bits from system binaries
RUN find / -xdev -perm /6000 -type f -exec chmod a-s {} + || true

# Lock root password
RUN passwd -l root

COPY common/scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

WORKDIR /home/learner
USER root
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
