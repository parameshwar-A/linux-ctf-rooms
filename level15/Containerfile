FROM linux-ctf-base:latest

USER root
COPY common/validator/clients/report_attacker.c /tmp/report_attacker.c
COPY level15/init.c /tmp/init.c
RUN gcc -O2 -s /tmp/init.c -o /usr/local/bin/init-room \
    && gcc -O2 -s /tmp/report_attacker.c -o /usr/local/bin/report_attacker \
    && chmod 0711 /usr/local/bin/report_attacker \
    && rm -f /tmp/init.c /tmp/report_attacker.c

WORKDIR /home/learner
CMD ["/bin/bash"]
